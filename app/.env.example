# Node.js 22.23.2 oder neuer; SQLite muss auf dauerhaftem lokalen Speicher liegen.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://tickets.dorfkinoloegow.de
DATABASE_PATH=./data/kino.sqlite
# Zwei verschiedene Geheimnisse, jeweils mindestens 32 zufaellige Zeichen.
ADMIN_TOKEN=
SYNC_TOKEN=
# Anbieter bestaetigt Host, Port und Zugang. Port 465: SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@dorfkinoloegow.de
# Google-App-Passwort direkt im Hosting hinterlegen, nicht das normale Kontopasswort.
SMTP_PASS=
MAIL_FROM=Dorfkino Lögow <info@dorfkinoloegow.de>
MAIL_REPLY_TO=info@dorfkinoloegow.de
# Absolute, tatsaechlich vorhandene Seiten eintragen.
PRIVACY_URL=https://dorfkinoloegow.de/datenschutzhinweise/
IMPRINT_URL=https://dorfkinoloegow.de/impressum/
# Nur setzen, wenn der Hoster eingehende X-Forwarded-For-Header sicher ersetzt.
TRUST_PROXY=false
